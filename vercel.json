{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/db/:path*", "destination": "/api/db/:path*" },
    { "source": "/api/db-v5/:path*", "destination": "/api/db-v5/:path*" },
    { "source": "/api/nominatim/:path*", "destination": "/api/nominatim/:path*" },
    { "source": "/((?!api/|assets/|sw.js|manifest.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
